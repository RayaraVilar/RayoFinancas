# Copy to .env.production only on the server. Never commit the populated file.
RAYO_APP_DOMAIN=app.example.com
RAYO_API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=rayo
POSTGRES_USER=rayo
POSTGRES_PASSWORD=replace-with-a-long-random-password
RAYO_DATABASE_URL=postgresql+asyncpg://rayo:replace-with-a-long-random-password@db:5432/rayo
RAYO_REDIS_URL=redis://redis:6379/0

RAYO_ENVIRONMENT=production
RAYO_LOG_LEVEL=INFO
RAYO_SECRET_KEY=replace-with-at-least-32-random-characters
RAYO_FRONTEND_URL=https://app.example.com
RAYO_PUBLIC_API_URL=https://api.example.com

RAYO_GOOGLE_CLIENT_ID=
RAYO_GOOGLE_CLIENT_SECRET=
RAYO_GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback

RAYO_PLUGGY_ENABLED=true
RAYO_PLUGGY_CLIENT_ID=
RAYO_PLUGGY_CLIENT_SECRET=
RAYO_PLUGGY_WEBHOOK_SECRET=
RAYO_PLUGGY_API_URL=https://api.pluggy.ai

RAYO_OPENAI_API_KEY=
RAYO_OPENAI_MODEL=gpt-5.6-sol

RAYO_PAYMENT_INITIATION_ENABLED=false
RAYO_PAYMENT_KILL_SWITCH=true
RAYO_PAYMENT_PROVIDER=
