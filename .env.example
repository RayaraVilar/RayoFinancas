# Local development only. Never reuse these values in a shared environment.
POSTGRES_DB=rayo
POSTGRES_USER=rayo
POSTGRES_PASSWORD=change-me-locally
RAYO_DATABASE_URL=postgresql+asyncpg://rayo:change-me-locally@localhost:5432/rayo
RAYO_ENVIRONMENT=development
RAYO_LOG_LEVEL=INFO
RAYO_SECRET_KEY=replace-with-at-least-32-random-characters
RAYO_FRONTEND_URL=http://localhost:3000
RAYO_PUBLIC_API_URL=http://localhost:8000
RAYO_GOOGLE_CLIENT_ID=
RAYO_GOOGLE_CLIENT_SECRET=
RAYO_GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
RAYO_PLUGGY_ENABLED=false
RAYO_PLUGGY_CLIENT_ID=
RAYO_PLUGGY_CLIENT_SECRET=
RAYO_PLUGGY_WEBHOOK_SECRET=
RAYO_PLUGGY_API_URL=https://api.pluggy.ai
RAYO_AI_PROVIDER=gemini
RAYO_GEMINI_MODEL=gemini-2.5-flash
RAYO_REDIS_URL=redis://localhost:6379/0
RAYO_PAYMENT_INITIATION_ENABLED=false
RAYO_PAYMENT_KILL_SWITCH=true
RAYO_PAYMENT_PROVIDER=
INTERNAL_API_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000
